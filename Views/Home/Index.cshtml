@{
    ViewData["Title"] = "Emma AI — Inteligencia Artificial Gratuita";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Emma AI — Accede a múltiples modelos de inteligencia artificial en un solo lugar. Gratuito, sin límites y con seguridad integrada." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>

    <!-- ════════════ NAVIGATION ════════════ -->
    <nav class="nav">
        <div class="nav-container">
            <a href="/" class="nav-brand">
                <div class="nav-brand-icon">E</div>
                <span>Emma AI</span>
            </a>
            <div class="nav-links">
                <a href="#modelos" class="nav-link">Modelos</a>
                <a href="#caracteristicas" class="nav-link">Características</a>
                <a href="#seguridad" class="nav-link">Seguridad</a>
                <a href="#como-funciona" class="nav-link">Cómo funciona</a>
            </div>
            <div class="nav-actions">
                <a href="/Account/Account" class="btn btn-ghost">Iniciar sesión</a>
                <a href="/Register/Register" class="btn btn-primary">Comenzar gratis</a>
            </div>
        </div>
    </nav>

    <!-- ════════════ HERO ════════════ -->
    <section class="hero">
        <div class="hero-bg">
            <div class="hero-bg-grid"></div>
            <div class="hero-bg-glow"></div>
            <div class="hero-bg-glow-2"></div>
        </div>

        <div class="hero-content">
            <div class="hero-text">
                <div class="hero-badge">
                    <div class="hero-badge-dot"></div>
                    3 MODELOS · ACCESO GRATUITO
                </div>
                <h1 class="hero-title">
                    Inteligencia artificial <span class="hero-title-gradient">de clase mundial</span> al alcance de todos
                </h1>
                <p class="hero-subtitle">
                    Emma AI integra múltiples modelos de lenguaje avanzados en una sola plataforma.
                    Escribe, programa, analiza y crea con respuestas precisas en tiempo real.
                </p>
                <div class="hero-cta">
                    <a href="/Register/Register" class="btn btn-primary btn-lg">Comenzar gratis</a>
                    <a href="#como-funciona" class="btn btn-ghost btn-lg">Ver cómo funciona</a>
                </div>
                <div class="hero-note">
                    Sin tarjeta de crédito · Sin límite de tiempo · Configuración en 30 segundos
                </div>
            </div>

            <div class="hero-visual">
                <div class="hero-card">
                    <div class="hero-card-header">
                        <div class="hero-card-dots">
                            <div class="hero-card-dot"></div>
                            <div class="hero-card-dot"></div>
                            <div class="hero-card-dot"></div>
                        </div>
                        <div class="hero-card-title">emma-ai.app</div>
                    </div>
                    <div class="hero-chat-preview">
                        <div class="hero-msg">
                            <div class="hero-msg-avatar user">Tú</div>
                            <div class="hero-msg-bubble user">¿Cómo implemento autenticación JWT en Node.js?</div>
                        </div>
                        <div class="hero-msg">
                            <div class="hero-msg-avatar ai">E</div>
                            <div class="hero-msg-bubble ai">
                                La autenticación JSON Web Token (JWT) es un estándar para transmitir información de forma segura.
                                En Node.js, puedes implementarla con la librería <code>jsonwebtoken</code>:
                                <br /><br />
                                1. Instala la dependencia con <code>npm install jsonwebtoken</code><br />
                                2. Genera tokens al iniciar sesión<br />
                                3. Verifica el token en cada ruta protegida<br />
                                4. Almacena el token del lado del cliente
                            </div>
                        </div>
                        <div class="hero-msg">
                            <div class="hero-msg-avatar user">Tú</div>
                            <div class="hero-msg-bubble user">¿Puedes darme un ejemplo de código?</div>
                        </div>
                        <div class="hero-msg">
                            <div class="hero-msg-avatar ai">E</div>
                            <div class="hero-msg-bubble ai">
                                Claro. Aquí tienes un ejemplo completo con Express que incluye middleware de verificación y manejo de errores.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="hero-float-badge hero-float-badge-1">
                    <div class="hero-float-icon" style="background: var(--accent-glow);">⚡</div>
                    <div class="hero-float-text">
                        <div class="hero-float-name">Emma 3.1</div>
                        <div class="hero-float-sub">Ultra rápido</div>
                    </div>
                </div>
                <div class="hero-float-badge hero-float-badge-2">
                    <div class="hero-float-icon" style="background: rgba(139,92,246,0.15);">🔒</div>
                    <div class="hero-float-text">
                        <div class="hero-float-name">Seguro</div>
                        <div class="hero-float-sub">Datos protegidos</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════ MODELS ════════════ -->
    <section class="models-section" id="modelos">
        <div class="section-container">
            <div class="section-header reveal">
                <div class="section-tag">// Modelos disponibles</div>
                <h2 class="section-title">Tres modelos. <span class="hero-title-gradient">Una plataforma.</span></h2>
                <p class="section-subtitle">Cada modelo tiene fortalezas específicas. Elige el que mejor se adapte a tu tarea o cambia entre ellos cuando quieras.</p>
            </div>
            <div class="models-grid">
                <div class="model-card reveal">
                    <div class="model-card-badge">GRATIS</div>
                    <div class="model-card-icon" style="background: rgba(99,102,241,0.12);">🧠</div>
                    <div class="model-card-name">Emma 3.1</div>
                    <div class="model-card-provider">70B parámetros · Infraestructura Groq</div>
                    <p class="model-card-desc">Modelo de lenguaje con 70 mil millones de parámetros optimizado para velocidad extrema. Ideal para razonamiento complejo, análisis detallado y tareas que requieren procesamiento rápido.</p>
                    <div class="model-card-tags">
                        <span class="model-card-tag">Razonamiento</span>
                        <span class="model-card-tag">Ultra rápido</span>
                        <span class="model-card-tag">Código</span>
                    </div>
                </div>
                <div class="model-card reveal reveal-delay-1">
                    <div class="model-card-badge">GRATIS</div>
                    <div class="model-card-icon" style="background: rgba(139,92,246,0.12);">✨</div>
                    <div class="model-card-name">Emma Opus 5</div>
                    <div class="model-card-provider">Google DeepMind · Multimodal</div>
                    <p class="model-card-desc">Modelo multimodal avanzado con capacidad de procesar texto, imágenes y contexto completo. Perfecto para preguntas generales, análisis de documentos y tareas creativas del día a día.</p>
                    <div class="model-card-tags">
                        <span class="model-card-tag">Multimodal</span>
                        <span class="model-card-tag">Versátil</span>
                        <span class="model-card-tag">General</span>
                    </div>
                </div>
                <div class="model-card reveal reveal-delay-2">
                    <div class="model-card-badge">GRATIS</div>
                    <div class="model-card-icon" style="background: rgba(16,185,129,0.12);">🔬</div>
                    <div class="model-card-name">Emma Max</div>
                    <div class="model-card-provider">Especialista técnico · Alta precisión</div>
                    <p class="model-card-desc">Especialista en código, matemáticas y análisis técnico. Diseñado para ofrecer respuestas precisas con excelente capacidad de seguimiento de instrucciones complejas.</p>
                    <div class="model-card-tags">
                        <span class="model-card-tag">Código</span>
                        <span class="model-card-tag">Análisis</span>
                        <span class="model-card-tag">Preciso</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════ FEATURES ════════════ -->
    <section class="section" id="caracteristicas">
        <div class="section-container">
            <div class="section-header reveal">
                <div class="section-tag">// Características</div>
                <h2 class="section-title">Todo lo que necesitas, <span class="hero-title-gradient">nada que no</span></h2>
                <p class="section-subtitle">Diseñado para ser simple pero poderoso. Sin configuraciones complicadas ni suscripciones ocultas.</p>
            </div>
            <div class="features-grid">
                <div class="feature-card reveal">
                    <div class="feature-icon">💬</div>
                    <div class="feature-title">Chat intuitivo</div>
                    <div class="feature-desc">Interfaz familiar y limpia. Escribe y recibe respuestas al instante con streaming en tiempo real. Soporte completo para Markdown y resaltado de sintaxis.</div>
                </div>
                <div class="feature-card reveal reveal-delay-1">
                    <div class="feature-icon">🔀</div>
                    <div class="feature-title">Cambio de modelo</div>
                    <div class="feature-desc">Alterna entre Emma 3.1, Emma Opus 5 y Emma Max sin perder tu conversación ni el contexto. Cada modelo aporta fortalezas únicas.</div>
                </div>
                <div class="feature-card reveal reveal-delay-2">
                    <div class="feature-icon">📂</div>
                    <div class="feature-title">Historial organizado</div>
                    <div class="feature-desc">Todas tus conversaciones se guardan automáticamente y se organizan por fecha. Retoma donde lo dejaste cuando quieras.</div>
                </div>
                <div class="feature-card reveal reveal-delay-3">
                    <div class="feature-icon">⚙️</div>
                    <div class="feature-title">Configuración avanzada</div>
                    <div class="feature-desc">Ajusta temperatura, longitud de respuesta, modo de pensamiento y más desde el panel de configuración. Personaliza tu experiencia.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════ SECURITY ════════════ -->
    <section class="security-section" id="seguridad">
        <div class="section-container">
            <div class="section-header reveal">
                <div class="section-tag">// Seguridad y privacidad</div>
                <h2 class="section-title">Tu información, <span class="hero-title-gradient">protegida</span></h2>
                <p class="section-subtitle">La seguridad es fundamental en Emma AI. Conoce cómo protegemos tus datos y qué debes tener en cuenta al usar inteligencia artificial.</p>
            </div>
            <div class="security-grid">
                <div class="security-content">
                    <div class="security-list">
                        <div class="security-item reveal">
                            <div class="security-item-icon">🔐</div>
                            <div>
                                <div class="security-item-title">Cifrado de extremo a extremo</div>
                                <div class="security-item-desc">Todas las comunicaciones entre tu navegador y nuestros servidores están cifradas con TLS 1.3.</div>
                            </div>
                        </div>
                        <div class="security-item reveal reveal-delay-1">
                            <div class="security-item-icon">🛡️</div>
                            <div>
                                <div class="security-item-title">Datos no compartidos</div>
                                <div class="security-item-desc">No vendemos ni compartimos tus conversaciones con terceros. Tu historial es privado y accesible solo para ti.</div>
                            </div>
                        </div>
                        <div class="security-item reveal reveal-delay-2">
                            <div class="security-item-icon">🔑</div>
                            <div>
                                <div class="security-item-title">Autenticación segura</div>
                                <div class="security-item-desc">Contraseñas almacenadas con hashing bcrypt. Sesiones con tokens seguros y expiración automática.</div>
                            </div>
                        </div>
                        <div class="security-item reveal reveal-delay-3">
                            <div class="security-item-icon">📋</div>
                            <div>
                                <div class="security-item-title">Control total</div>
                                <div class="security-item-desc">Puedes eliminar tus conversaciones en cualquier momento. Tienes control completo sobre tu información.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="security-clauses reveal">
                    <div class="security-clauses-title">
                        <span>⚠️</span> Cláusulas de uso responsable
                    </div>
                    <div class="security-clause">
                        <div class="security-clause-title">Verificación de información</div>
                        <div class="security-clause-desc">Los modelos de IA pueden generar respuestas incorrectas o imprecisas. Verifica siempre la información crítica antes de tomar decisiones basadas en ella.</div>
                    </div>
                    <div class="security-clause">
                        <div class="security-clause-title">Contenido generado</div>
                        <div class="security-clause-desc">Las respuestas son generadas automáticamente y no constituyen asesoramiento profesional, médico, legal o financiero.</div>
                    </div>
                    <div class="security-clause">
                        <div class="security-clause-title">Datos personales</div>
                        <div class="security-clause-desc">No ingreses información personal sensible, contraseñas, datos bancarios o información confidencial en las conversaciones.</div>
                    </div>
                    <div class="security-clause">
                        <div class="security-clause-title">Uso ético</div>
                        <div class="security-clause-desc">No utilices la plataforma para generar contenido ilegal, dañino, discriminatorio o que infrinja derechos de terceros.</div>
                    </div>
                    <div class="security-clause">
                        <div class="security-clause-title">Limitaciones del servicio</div>
                        <div class="security-clause-desc">El servicio se proporciona "tal cual". Pueden existir interrupciones, limitaciones de capacidad o cambios en los modelos disponibles.</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════ HOW IT WORKS ════════════ -->
    <section class="section" id="como-funciona">
        <div class="section-container">
            <div class="section-header reveal">
                <div class="section-tag">// Cómo funciona</div>
                <h2 class="section-title">En 4 pasos, <span class="hero-title-gradient">listo</span></h2>
                <p class="section-subtitle">Sin instalaciones, sin configuraciones complicadas. Empieza a usar IA en menos de un minuto.</p>
            </div>
            <div class="steps-grid">
                <div class="step reveal">
                    <div class="step-number">1</div>
                    <div class="step-icon">📧</div>
                    <div class="step-title">Crea tu cuenta</div>
                    <div class="step-desc">Regístrate con tu correo electrónico. Gratis para siempre, sin tarjeta de crédito.</div>
                </div>
                <div class="step reveal reveal-delay-1">
                    <div class="step-number">2</div>
                    <div class="step-icon">🤖</div>
                    <div class="step-title">Elige tu modelo</div>
                    <div class="step-desc">Selecciona entre Emma 3.1, Emma Opus 5 o Emma Max según la tarea que tengas en mente.</div>
                </div>
                <div class="step reveal reveal-delay-2">
                    <div class="step-number">3</div>
                    <div class="step-icon">💬</div>
                    <div class="step-title">Escribe tu pregunta</div>
                    <div class="step-desc">Pregunta lo que necesites en español o cualquier idioma. Sin comandos especiales.</div>
                </div>
                <div class="step reveal reveal-delay-3">
                    <div class="step-number">4</div>
                    <div class="step-icon">🚀</div>
                    <div class="step-title">Obtén tu respuesta</div>
                    <div class="step-desc">Recibe respuestas precisas en segundos. Itera, refina y comparte con facilidad.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════ CTA ════════════ -->
    <section class="cta-section">
        <div class="cta-content">
            <h2 class="cta-title reveal">¿Listo para usar <span class="hero-title-gradient">IA de verdad</span>?</h2>
            <p class="cta-subtitle reveal reveal-delay-1">Crea tu cuenta gratuita y comienza a conversar con inteligencia artificial avanzada ahora mismo.</p>
            <div class="cta-buttons reveal reveal-delay-2">
                <a href="/Register/Register" class="btn btn-primary btn-lg">Crear cuenta gratis</a>
                <a href="#modelos" class="btn btn-ghost btn-lg">Conocer los modelos</a>
            </div>
        </div>
    </section>

    <!-- ════════════ FOOTER ════════════ -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <div class="footer-logo-icon">E</div>
                        <span>Emma AI</span>
                    </div>
                    <p class="footer-desc">Plataforma de inteligencia artificial gratuita. Múltiples modelos, un solo lugar, seguridad integrada.</p>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Producto</div>
                    <ul>
                        <li><a href="#caracteristicas">Características</a></li>
                        <li><a href="#modelos">Modelos</a></li>
                        <li><a href="#como-funciona">Cómo funciona</a></li>
                        <li><a href="#seguridad">Seguridad</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Recursos</div>
                    <ul>
                        <li><a href="#">Documentación</a></li>
                        <li><a href="#">Guías de uso</a></li>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Estado del servicio</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Legal</div>
                    <ul>
                        <li><a href="#">Términos de servicio</a></li>
                        <li><a href="#">Política de privacidad</a></li>
                        <li><a href="#">Política de cookies</a></li>
                        <li><a href="#">Contacto</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="footer-copy">© 2026 Emma AI · Todos los derechos reservados</div>
                <div class="footer-legal">
                    <a href="#">Términos</a>
                    <a href="#">Privacidad</a>
                    <a href="#">Cookies</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</body>
</html>
