@model Proyecto_ai.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Registro - Emma AI";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true">
</head>
<body>
    <div class="screen auth-screen active" id="registerScreen">
        <div class="orb o1"></div>
        <div class="orb o2"></div>

        <div class="acard">
            <div class="a-logo">
                <svg class="a-logo-icon pulse" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                    <rect width="64" height="64" rx="16" fill="#0c1225" />
                    <rect x=".5" y=".5" width="63" height="63" rx="15.5" stroke="#5b9cf6" stroke-opacity=".28" />
                    <path d="M32 15C28 12.5 21 13.5 18 18.5C15.5 22.5 16 27 18.5 30.5C16.5 32 15.5 36 17 39.5C18.5 43.5 22.5 44.5 25.5 43C27 46 29.5 47.5 32 47" stroke="#5b9cf6" stroke-width="2" stroke-linecap="round" />
                    <path d="M32 15C36 12.5 43 13.5 46 18.5C48.5 22.5 48 27 45.5 30.5C47.5 32 48.5 36 47 39.5C45.5 43.5 41.5 44.5 38.5 43C37 46 34.5 47.5 32 47" stroke="#5b9cf6" stroke-width="2" stroke-linecap="round" />
                    <line x1="32" y1="15" x2="32" y2="47" stroke="#5b9cf6" stroke-width="1.4" stroke-dasharray="3 2.2" />
                    <circle cx="32" cy="31" r="3.2" fill="#5b9cf6" />
                </svg>
                <div class="a-logo-name">Emma<span>AI</span></div>
            </div>

            <div class="a-title">Crear tu cuenta gratuita</div>
            <div class="a-sub">Accede a Nemotron, Laguna y North Mini Code desde un solo chat.</div>

            <form method="post" asp-controller="Register" asp-action="Registrarme" novalidate>
                <div asp-validation-summary="ModelOnly" class="auth-alert error"></div>

                <div class="name-row">
                    <div class="field">
                        <label asp-for="Nombre">Nombre</label>
                        <input asp-for="Nombre" type="text" placeholder="Santos" autocomplete="given-name" />
                        <span asp-validation-for="Nombre" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Apellido">Apellido</label>
                        <input asp-for="Apellido" type="text" placeholder="Lacorte" autocomplete="family-name" />
                        <span asp-validation-for="Apellido" class="field-error"></span>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Correo">Correo electronico</label>
                    <input asp-for="Correo" type="email" placeholder="tu@email.com" autocomplete="email" />
                    <span asp-validation-for="Correo" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Contrasena</label>
                    <div class="pw-wrap">
                        <input asp-for="Password" type="password" placeholder="Letras y numeros" id="registerPassword" autocomplete="new-password" />
                        <button class="pw-eye" type="button" onclick="togglePassword('registerPassword')">ver</button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirPassword">Confirmar contrasena</label>
                    <div class="pw-wrap">
                        <input asp-for="ConfirPassword" type="password" placeholder="Repite tu contrasena" id="confirmPassword" autocomplete="new-password" />
                        <button class="pw-eye" type="button" onclick="togglePassword('confirmPassword')">ver</button>
                    </div>
                    <span asp-validation-for="ConfirPassword" class="field-error"></span>
                </div>

                <button class="a-btn" type="submit">Crear cuenta gratis</button>
            </form>

            <div class="a-link">Ya tienes cuenta? <a asp-controller="Account" asp-action="Account">Inicia sesion</a></div>
        </div>
    </div>

    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
