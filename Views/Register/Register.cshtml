@model Proyecto_ai.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Crear cuenta - Emma AI";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/Emma.ico" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body>
    <main class="auth-layout">
        <aside class="auth-brand-panel">
            <div class="auth-brand-top">
                <a class="auth-brand" href="/">
                    <div class="auth-logo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                            <path d="M2 17l10 5 10-5"/>
                            <path d="M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <span class="auth-brand-name">Emma<span>AI</span></span>
                </a>
                <span class="auth-product-label"><span class="status-dot"></span> Tu espacio de IA</span>
            </div>

            <section class="auth-brand-copy">
                <span class="auth-eyebrow">Una cuenta, más posibilidades</span>
                <h1>Ideas grandes.<br><span>Un espacio para hacerlas realidad.</span></h1>
                <p>Reúne tus conversaciones y accede a distintos modelos de IA desde un solo lugar.</p>
            </section>

            <div class="auth-preview">
                <div class="preview-heading">
                    <span class="preview-avatar">E</span>
                    <span class="preview-title">
                        <strong>Tu espacio de trabajo</strong>
                        <small>Listo para empezar</small>
                    </span>
                    <span class="preview-live"><span class="status-dot"></span> Activo</span>
                </div>
                <p class="preview-message">¿Qué te gustaría crear hoy?</p>
                <div class="preview-models">
                    <span>Nemotron</span>
                    <span>Laguna</span>
                    <span>North Mini Code</span>
                </div>
            </div>

            <p class="auth-brand-footnote">Tu próximo proyecto empieza con una buena pregunta.</p>
        </aside>

        <section class="auth-form-panel">
            <div class="auth-top-link">
                <a href="/">Volver al inicio</a>
                <span>Acceso protegido</span>
            </div>

            <div class="auth-form-content">
                <header class="auth-heading">
                    <span class="auth-eyebrow">Empieza gratis</span>
                    <h2>Crea tu cuenta</h2>
                    <p>Completa tus datos y empieza a explorar Emma AI.</p>
                </header>

                <form method="post" asp-controller="Register" asp-action="Registrarme" novalidate>
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="auth-name-row">
                        <div class="auth-field">
                            <label asp-for="Nombre">Nombre</label>
                            <input asp-for="Nombre" class="auth-input" type="text" placeholder="Tu nombre" autocomplete="given-name" />
                            <span asp-validation-for="Nombre" class="field-error"></span>
                        </div>
                        <div class="auth-field">
                            <label asp-for="Apellido">Apellido</label>
                            <input asp-for="Apellido" class="auth-input" type="text" placeholder="Tu apellido" autocomplete="family-name" />
                            <span asp-validation-for="Apellido" class="field-error"></span>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Correo">Correo electrónico</label>
                        <input asp-for="Correo" class="auth-input" type="email" placeholder="nombre@correo.com" autocomplete="email" />
                        <span asp-validation-for="Correo" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">Contraseña</label>
                        <div class="auth-password-wrap">
                            <input asp-for="Password" class="auth-input" type="password" placeholder="Crea una contraseña" id="registerPassword" autocomplete="new-password" aria-describedby="passwordHelp" />
                            <button class="password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Mostrar contraseña" aria-pressed="false">Mostrar</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                        <small class="field-hint" id="passwordHelp">Mínimo 8 caracteres, con letras y números.</small>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                        <div class="auth-password-wrap">
                            <input asp-for="ConfirmPassword" class="auth-input" type="password" placeholder="Escríbela de nuevo" id="confirmPassword" autocomplete="new-password" />
                            <button class="password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Mostrar confirmación de contraseña" aria-pressed="false">Mostrar</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button class="auth-submit" type="submit">Crear cuenta</button>
                </form>

                <p class="auth-switch">¿Ya tienes una cuenta? <a asp-controller="Account" asp-action="Account">Inicia sesión</a></p>
            </div>

            <p class="auth-form-footnote">Al continuar, podrás entrar con tu correo y contraseña.</p>
        </section>
    </main>

    <script>
        document.querySelectorAll('[data-password-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.passwordToggle);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.textContent = show ? 'Ocultar' : 'Mostrar';
                button.setAttribute('aria-pressed', String(show));
                button.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
