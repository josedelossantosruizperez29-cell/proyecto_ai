@model Proyecto_ai.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Crear cuenta — Emma AI";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b0c11">
    <meta name="description" content="Crea tu cuenta de Emma AI y reúne tus conversaciones, modelos y contexto en un solo lugar.">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/Emma.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body>
    <main class="auth-shell">
        <aside class="auth-brand">
            <a class="auth-logo" href="/">
                <span class="auth-mark"><img src="~/img/logo.png" alt="" width="52" height="52" /></span>
                <span>Emma AI</span>
            </a>

            <div class="auth-brand-body">
                <h1 class="auth-tagline">Conversaciones que continúan.</h1>
                <p class="auth-tagline-sub">Tus chats, tus modelos y el contexto de cada conversación, en una sola cuenta.</p>

                <ul class="auth-features">
                    <li class="auth-feature">
                        <span class="auth-feature-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                        </span>
                        <span class="auth-feature-text">
                            <strong>Historial que no se pierde</strong>
                            <span>Retoma cualquier conversación exactamente donde la dejaste.</span>
                        </span>
                    </li>
                    <li class="auth-feature">
                        <span class="auth-feature-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="4" y1="21" x2="4" y2="14" />
                                <line x1="4" y1="10" x2="4" y2="3" />
                                <line x1="12" y1="21" x2="12" y2="12" />
                                <line x1="12" y1="8" x2="12" y2="3" />
                                <line x1="20" y1="21" x2="20" y2="16" />
                                <line x1="20" y1="12" x2="20" y2="3" />
                                <line x1="1" y1="14" x2="7" y2="14" />
                                <line x1="9" y1="8" x2="15" y2="8" />
                                <line x1="17" y1="16" x2="23" y2="16" />
                            </svg>
                        </span>
                        <span class="auth-feature-text">
                            <strong>Un modelo para cada tarea</strong>
                            <span>Cambia de modelo y modo sin perder el contexto.</span>
                        </span>
                    </li>
                    <li class="auth-feature">
                        <span class="auth-feature-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </span>
                        <span class="auth-feature-text">
                            <strong>Siempre en tu cuenta</strong>
                            <span>Tus conversaciones te acompañan en cualquier dispositivo.</span>
                        </span>
                    </li>
                </ul>
            </div>
        </aside>

        <section class="auth-panel">
            <header class="auth-panel-top">
                <a class="auth-back" href="/">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M19 12H5" />
                        <path d="m12 19-7-7 7-7" />
                    </svg>
                    Volver al inicio
                </a>
            </header>

            <div class="auth-card">
                <a class="auth-mobile-logo" href="/">
                    <span class="auth-mark"><img src="~/img/logo.png" alt="" width="52" height="52" /></span>
                    <span>Emma AI</span>
                </a>

                <header class="auth-heading">
                    <h1>Crear cuenta</h1>
                    <p>Empieza gratis. Solo necesitas un correo y una contraseña.</p>
                </header>

                <form method="post" asp-controller="Register" asp-action="Registrarme" novalidate class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error" role="alert"></div>

                    <div class="auth-name-row">
                        <div class="auth-field">
                            <label asp-for="Nombre">Nombre</label>
                            <input asp-for="Nombre" class="auth-input" type="text" placeholder="Tu nombre" autocomplete="given-name" required />
                            <span asp-validation-for="Nombre" class="field-error"></span>
                        </div>
                        <div class="auth-field">
                            <label asp-for="Apellido">Apellido</label>
                            <input asp-for="Apellido" class="auth-input" type="text" placeholder="Tu apellido" autocomplete="family-name" required />
                            <span asp-validation-for="Apellido" class="field-error"></span>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Correo">Correo electrónico</label>
                        <input asp-for="Correo" class="auth-input" type="email" placeholder="nombre@correo.com" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required />
                        <span asp-validation-for="Correo" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">Contraseña</label>
                        <div class="auth-password">
                            <input asp-for="Password" class="auth-input" type="password" placeholder="Crea una contraseña" id="registerPassword" autocomplete="new-password" aria-describedby="passwordHelp" required />
                            <button class="password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Mostrar contraseña" aria-pressed="false">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                                    <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                                    <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                                    <path d="m2 2 20 20" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                        <small class="field-hint" id="passwordHelp">Mínimo 8 caracteres, con letras y números.</small>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                        <div class="auth-password">
                            <input asp-for="ConfirmPassword" class="auth-input" type="password" placeholder="Escríbela de nuevo" id="confirmPassword" autocomplete="new-password" required />
                            <button class="password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Mostrar confirmación de contraseña" aria-pressed="false">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                                    <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                                    <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                                    <path d="m2 2 20 20" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button class="auth-submit" type="submit" data-loading="Creando cuenta…">
                        <span class="btn-spinner" aria-hidden="true"></span>
                        <span class="btn-label">Crear cuenta</span>
                    </button>
                </form>

                <p class="auth-switch">¿Ya tienes una cuenta? <a asp-controller="Account" asp-action="Account">Iniciar sesión</a></p>
            </div>

            <footer class="auth-panel-foot">
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    Conexión segura
                </span>
                <span>© @DateTime.Now.Year Emma AI</span>
            </footer>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
