@model Proyecto_ai.Models.DashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Emma AI";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/dashboardstyle.css" asp-append-version="true">
</head>
<body>
    <div class="app-container" data-default-model="@Model.DefaultModelId" data-default-mode="@Model.ThinkingMode">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="ai-branding">
                    <div class="ai-logo-text">EA</div>
                    <span class="ai-name">Emma AI</span>
                    <span class="ai-badge">Free</span>
                </div>
                <button class="new-chat-btn" type="button" onclick="newChat()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Nuevo chat
                </button>
            </div>

            <div class="chat-history" id="chatHistory">
                <div class="chat-history-label">Historial</div>
                <div class="empty-history" id="emptyHistory">Aun no tienes conversaciones.</div>
            </div>

            <div class="sidebar-profile">
                <div class="profile-card" onclick="openSettings()">
                    <div class="profile-avatar" id="sidebarAvatar">@Model.Initials</div>
                    <div class="profile-info">
                        <div class="profile-name" id="sidebarName">@Model.Nombre @Model.Apellido</div>
                        <div class="profile-email" id="sidebarEmail">@Model.Correo</div>
                    </div>
                    <svg class="profile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <div class="top-bar">
                <div class="top-bar-left">
                    <button class="menu-toggle" type="button" onclick="toggleSidebar()" title="Menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>

                    <div class="model-selector-wrapper">
                        <select class="model-selector" id="modelSelector" onchange="changeModel()">
                            @foreach (var aiModel in Model.Models)
                            {
                                <option value="@aiModel.Id" selected="@(aiModel.Id == Model.DefaultModelId)">@aiModel.Name</option>
                            }
                        </select>
                        <div class="model-selector-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>

                    <div class="model-selector-wrapper">
                        <select class="model-selector thinking-selector" id="thinkingModeSelector" onchange="changeThinkingMode()">
                            @foreach (var mode in Model.ThinkingModes)
                            {
                                <option value="@mode.Id" selected="@(mode.Id == Model.ThinkingMode)">@mode.Name</option>
                            }
                        </select>
                        <div class="model-selector-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>

                    <span class="model-badge pro" id="modelBadge">Listo</span>
                </div>
            </div>

            <div class="chat-area" id="chatArea">
                <div class="welcome-screen" id="welcomeScreen">
                    <div class="welcome-icon text-logo">EA</div>
                    <h1 class="welcome-title">En que puedo ayudarte?</h1>
                    <p class="welcome-subtitle">Elige un modelo gratuito y un modo de pensamiento. EMMA guarda tu historial y responde con el contexto de la conversacion.</p>
                    <div class="suggestions">
                        <button class="suggestion-card" type="button" onclick="useSuggestion('Explicame como funciona un API REST con un ejemplo corto')">
                            <span class="suggestion-title">Explicar conceptos</span>
                            <span class="suggestion-desc">API REST con ejemplo</span>
                        </button>
                        <button class="suggestion-card" type="button" onclick="useSuggestion('Revisa este codigo y dime como mejorarlo')">
                            <span class="suggestion-title">Revisar codigo</span>
                            <span class="suggestion-desc">Ayuda para programar</span>
                        </button>
                        <button class="suggestion-card" type="button" onclick="useSuggestion('Ayudame a redactar un correo profesional')">
                            <span class="suggestion-title">Redaccion</span>
                            <span class="suggestion-desc">Correo profesional</span>
                        </button>
                        <button class="suggestion-card" type="button" onclick="useSuggestion('Dame un plan simple para terminar mi proyecto hoy')">
                            <span class="suggestion-title">Plan rapido</span>
                            <span class="suggestion-desc">Organizar tareas</span>
                        </button>
                    </div>
                </div>

                <div class="messages-container" id="messagesContainer" style="display:none;"></div>
            </div>

            <div class="input-area">
                <div class="input-container">
                    <div class="input-box">
                        <textarea id="messageInput" placeholder="Escribe tu mensaje..." rows="1" onkeydown="handleKeyDown(event)" oninput="autoResize(this)"></textarea>
                        <button class="send-btn" id="sendBtn" type="button" onclick="sendMessage()" disabled title="Enviar">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                    <div class="input-footer">EMMA AI — Desarrollado por Jose de los Santos. Puede cometer errores, verifica la informacion.</div>
                </div>
            </div>
        </main>
    </div>

    <div class="settings-overlay" id="settingsOverlay" onclick="closeSettingsOnOverlay(event)">
        <div class="settings-panel">
            <div class="settings-header">
                <h2 class="settings-title">Ajustes</h2>
                <button class="settings-close" type="button" onclick="closeSettings()" title="Cerrar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="settings-body">
                <div class="settings-section">
                    <h3 class="settings-section-title">Perfil</h3>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsFirstName">Nombre</label>
                        <input type="text" class="settings-input" id="settingsFirstName" value="@Model.Nombre">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsLastName">Apellido</label>
                        <input type="text" class="settings-input" id="settingsLastName" value="@Model.Apellido">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsEmail">Correo electronico</label>
                        <input type="email" class="settings-input" id="settingsEmail" value="@Model.Correo" disabled>
                    </div>
                    <button class="settings-btn btn-primary" type="button" onclick="saveProfile()">Guardar cambios</button>
                </div>

                <div class="settings-section">
                    <h3 class="settings-section-title">Seguridad</h3>
                    <div class="settings-field">
                        <label class="settings-label" for="currentPassword">Contrasena actual</label>
                        <input type="password" class="settings-input" id="currentPassword">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="newPassword">Nueva contrasena</label>
                        <input type="password" class="settings-input" id="newPassword">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="confirmPassword">Confirmar nueva contrasena</label>
                        <input type="password" class="settings-input" id="confirmPassword">
                    </div>
                    <button class="settings-btn btn-secondary" type="button" onclick="changePassword()">Cambiar contrasena</button>
                </div>

                <div class="settings-section">
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <button class="settings-btn btn-logout" type="submit">Cerrar sesion</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
