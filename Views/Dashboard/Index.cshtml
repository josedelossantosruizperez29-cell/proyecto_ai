@model Proyecto_ai.Models.DashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Emma AI";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b0c11">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/Emma.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboardstyle.css" asp-append-version="true">
</head>
<body>
    <div class="app" data-default-model="@Model.DefaultModelId" data-default-mode="@Model.ThinkingMode">
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-top">
                <div class="brand">
                    <img class="brand-mark" src="~/img/logo.png" alt="" width="26" height="26" />
                    <span class="brand-name">Emma AI</span>
                    <span class="brand-tag">Free</span>
                    <button class="sidebar-close" type="button" onclick="toggleSidebar()" aria-label="Cerrar menú">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <button class="new-chat" type="button" onclick="newChat()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                    Nuevo chat
                </button>
            </div>

            <nav class="history" id="chatHistory" aria-label="Conversaciones">
                <div class="history-label">Recientes</div>
                <div class="empty-history" id="emptyHistory">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <p>Aún no tienes conversaciones</p>
                    <span>Tus chats aparecerán aquí, listos para continuar.</span>
                </div>
            </nav>

            <div class="sidebar-foot">
                <button class="user-card" type="button" onclick="openSettings()" aria-label="Abrir ajustes de la cuenta">
                    <span class="user-avatar" id="sidebarAvatar">@Model.Initials</span>
                    <span class="user-meta">
                        <span class="user-name" id="sidebarName">@Model.Nombre @Model.Apellido</span>
                        <span class="user-email" id="sidebarEmail">@Model.Correo</span>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="icon-btn menu-btn" type="button" onclick="toggleSidebar()" aria-label="Abrir menú">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>

                    <div class="select-wrap">
                        <select class="select" id="modelSelector" onchange="changeModel()" aria-label="Modelo de IA">
                            @foreach (var aiModel in Model.Models)
                            {
                                <option value="@aiModel.Id" selected="@(aiModel.Id == Model.DefaultModelId)">@aiModel.Name</option>
                            }
                        </select>
                        <span class="select-caret">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </span>
                    </div>

                    <div class="select-wrap">
                        <select class="select" id="thinkingModeSelector" onchange="changeThinkingMode()" aria-label="Modo de pensamiento">
                            @foreach (var mode in Model.ThinkingModes)
                            {
                                <option value="@mode.Id" selected="@(mode.Id == Model.ThinkingMode)">@mode.Name</option>
                            }
                        </select>
                        <span class="select-caret">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </span>
                    </div>

                    <span class="status-pill" id="modelBadge">Listo</span>
                </div>

                <div class="topbar-right">
                    <button class="icon-btn" type="button" onclick="openSettings()" title="Ajustes" aria-label="Ajustes">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </header>

            <div class="chat-area" id="chatArea">
                <section class="welcome" id="welcomeScreen">
                    <img class="welcome-mark" src="~/img/logo.png" alt="" width="60" height="60" />
                    <h1 class="welcome-title">¿En qué puedo ayudarte?</h1>
                    <p class="welcome-subtitle">Elige un modelo y un modo de pensamiento. Emma recuerda el contexto de tu conversación.</p>

                    <div class="suggestions">
                        <button class="suggestion-card" type="button" onclick="useSuggestion('Explícame cómo funciona un API REST con un ejemplo corto')">
                            <span class="suggestion-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                </svg>
                            </span>
                            <span class="suggestion-body">
                                <span class="suggestion-title">Explicar un concepto</span>
                                <span class="suggestion-desc">«¿Cómo funciona una API REST?»</span>
                            </span>
                        </button>

                        <button class="suggestion-card" type="button" onclick="useSuggestion('Revisa este código y dime cómo mejorarlo')">
                            <span class="suggestion-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"></polyline>
                                    <polyline points="8 6 2 12 8 18"></polyline>
                                </svg>
                            </span>
                            <span class="suggestion-body">
                                <span class="suggestion-title">Revisar código</span>
                                <span class="suggestion-desc">Depura, refactoriza o explica</span>
                            </span>
                        </button>

                        <button class="suggestion-card" type="button" onclick="useSuggestion('Ayúdame a redactar un correo profesional')">
                            <span class="suggestion-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                                </svg>
                            </span>
                            <span class="suggestion-body">
                                <span class="suggestion-title">Redactar un texto</span>
                                <span class="suggestion-desc">Correos, propuestas y mensajes</span>
                            </span>
                        </button>

                        <button class="suggestion-card" type="button" onclick="useSuggestion('Dame un plan simple para terminar mi proyecto hoy')">
                            <span class="suggestion-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 12H3"></path>
                                    <path d="M16 6H3"></path>
                                    <path d="M16 18H3"></path>
                                    <path d="m18 9 3 3-3 3"></path>
                                </svg>
                            </span>
                            <span class="suggestion-body">
                                <span class="suggestion-title">Organizar tareas</span>
                                <span class="suggestion-desc">Un plan claro para avanzar hoy</span>
                            </span>
                        </button>
                    </div>
                </section>

                <div class="messages" id="messagesContainer" style="display:none"></div>
            </div>

            <footer class="composer">
                <div class="composer-inner">
                    <div class="input-shell">
                        <textarea id="messageInput" placeholder="Escribe un mensaje…" rows="1" onkeydown="handleKeyDown(event)" oninput="autoResize(this)" aria-label="Mensaje"></textarea>
                        <div class="input-actions">
                            <button class="icon-btn" type="button" onclick="showImagePrompt()" title="Generar imagen" aria-label="Generar imagen">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="9" cy="9" r="2"></circle>
                                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                                </svg>
                            </button>
                            <button class="send-btn" id="sendBtn" type="button" onclick="sendMessage()" disabled title="Enviar" aria-label="Enviar mensaje">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 19V5"></path>
                                    <path d="m5 12 7-7 7 7"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <p class="composer-note">Emma AI puede cometer errores. Verifica la información importante.</p>
                </div>
            </footer>
        </main>
    </div>

    <div class="modal" id="imagePromptArea" style="display:none" role="dialog" aria-modal="true" aria-labelledby="imagePromptTitle">
        <div class="modal-scrim" onclick="hideImagePrompt()"></div>
        <div class="modal-card" id="imagePromptCard">
            <div class="modal-head">
                <h2 class="modal-title" id="imagePromptTitle">Generar imagen</h2>
                <button class="icon-btn" type="button" onclick="hideImagePrompt()" aria-label="Cerrar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <textarea id="imagePromptText" rows="3" placeholder="Describe la imagen que quieres crear…" aria-label="Descripción de la imagen"></textarea>
                <p class="modal-hint">Cuanto más específico seas, mejor será el resultado. Ejemplo: «Un faro en la costa al atardecer, estilo acuarela».</p>
            </div>
            <div class="modal-foot">
                <button class="btn ghost" type="button" onclick="hideImagePrompt()">Cancelar</button>
                <button class="btn primary" type="button" onclick="generateImage()">Generar imagen</button>
            </div>
            <div class="modal-loading" id="imageLoading">
                <span class="spinner"></span>
                <span>Generando tu imagen… esto puede tardar unos segundos.</span>
            </div>
        </div>
    </div>

    <div class="settings-overlay" id="settingsOverlay" onclick="closeSettingsOnOverlay(event)">
        <aside class="settings-panel" role="dialog" aria-modal="true" aria-label="Ajustes de la cuenta">
            <div class="settings-header">
                <div class="settings-header-left">
                    <div class="settings-avatar" id="settingsAvatar">@Model.Initials</div>
                    <div class="settings-header-info">
                        <h2 class="settings-title" id="settingsName">@Model.Nombre @Model.Apellido</h2>
                        <p class="settings-subtitle" id="settingsEmailText">@Model.Correo</p>
                    </div>
                </div>
                <button class="icon-btn" type="button" onclick="closeSettings()" aria-label="Cerrar ajustes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="settings-body">
                <div class="settings-section">
                    <h3 class="settings-section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Perfil
                    </h3>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsFirstName">Nombre</label>
                        <input type="text" class="settings-input" id="settingsFirstName" value="@Model.Nombre" autocomplete="given-name">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsLastName">Apellido</label>
                        <input type="text" class="settings-input" id="settingsLastName" value="@Model.Apellido" autocomplete="family-name">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsEmailInput">Correo electrónico</label>
                        <input type="email" class="settings-input" id="settingsEmailInput" value="@Model.Correo" disabled>
                        <span class="settings-hint">El correo no se puede modificar.</span>
                    </div>
                    <button class="btn primary settings-btn" type="button" onclick="saveProfile()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                        Guardar cambios
                    </button>
                </div>

                <div class="settings-section">
                    <h3 class="settings-section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Seguridad
                    </h3>
                    <div class="settings-field">
                        <label class="settings-label" for="currentPassword">Contraseña actual</label>
                        <input type="password" class="settings-input" id="currentPassword" placeholder="••••••••" autocomplete="current-password">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="newPassword">Nueva contraseña</label>
                        <input type="password" class="settings-input" id="newPassword" placeholder="Mínimo 8 caracteres" autocomplete="new-password">
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="confirmPassword">Confirmar nueva contraseña</label>
                        <input type="password" class="settings-input" id="confirmPassword" placeholder="Repite la contraseña" autocomplete="new-password">
                    </div>
                    <button class="btn ghost settings-btn" type="button" onclick="changePassword()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                        </svg>
                        Cambiar contraseña
                    </button>
                </div>

                <div class="settings-section">
                    <h3 class="settings-section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        Preferencias
                    </h3>
                    <div class="settings-field">
                        <span class="settings-label">Tema de la interfaz</span>
                        <div class="settings-segmented">
                            <button class="settings-segment active" type="button">Oscuro</button>
                            <button class="settings-segment" type="button">Claro</button>
                            <button class="settings-segment" type="button">Sistema</button>
                        </div>
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="settingsLanguage">Idioma</label>
                        <select id="settingsLanguage" class="settings-select">
                            <option value="es" selected>Español</option>
                            <option value="en">English</option>
                            <option value="pt">Português</option>
                        </select>
                    </div>
                </div>

                <div class="settings-section settings-section--danger">
                    <h3 class="settings-section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        Sesión
                    </h3>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <button class="btn danger settings-btn" type="submit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </div>
        </aside>
    </div>

    <div class="toast-container" id="toastContainer" role="status" aria-live="polite"></div>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/control.js" asp-append-version="true"></script>
</body>
</html>
